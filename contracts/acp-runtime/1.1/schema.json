{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agents-anywhere:acp-runtime:1.1",
  "$defs": {
    "capabilities": {
      "type": "object",
      "required": [
        "protocolVersion",
        "guarantees"
      ],
      "properties": {
        "protocolVersion": {
          "const": "1.1"
        },
        "guarantees": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "project_trust_before_resources",
              "durable_prompt_receipts",
              "frozen_tool_parameters",
              "final_model_request_guard",
              "native_writer_lease",
              "stable_native_identity"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "prepareRequest": {
      "type": "object",
      "required": [
        "cwd"
      ],
      "properties": {
        "preparationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "prepareResult": {
      "type": "object",
      "required": [
        "sessionId",
        "deferred",
        "ticket",
        "configOptions",
        "resourceFingerprint",
        "trustMode"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "deferred": {
          "const": true
        },
        "ticket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "configOptions": {
          "type": "array"
        },
        "resourceFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "trustMode": {
          "enum": [
            "basic",
            "once",
            "persistent"
          ]
        }
      },
      "additionalProperties": false
    },
    "newSessionMetadata": {
      "type": "object",
      "required": [
        "preparationId",
        "platformSessionId",
        "ownerGeneration"
      ],
      "properties": {
        "preparationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "platformSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ownerGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "selectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "promptMetadata": {
      "type": "object",
      "required": [
        "clientMessageId"
      ],
      "properties": {
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "operationUpdate": {
      "type": "object",
      "required": [
        "agentSessionId",
        "sessionId",
        "clientMessageId",
        "ownerGeneration",
        "messageAccepted"
      ],
      "properties": {
        "agentSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "externalSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ownerGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "messageAccepted": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "created": {
          "type": "boolean"
        },
        "disposition": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operationQuery": {
      "type": "object",
      "required": [
        "sessionId",
        "clientMessageId"
      ],
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clientMessageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "required": [
        "piSessionId",
        "sourceEpoch",
        "leafId",
        "anchorDigest",
        "positionRevision",
        "branchGeneration",
        "ownerGeneration",
        "fileEntriesDigest",
        "clean"
      ],
      "properties": {
        "piSessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sourceEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "leafId": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchorDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "positionRevision": {
          "type": "integer",
          "minimum": 0
        },
        "branchGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "ownerGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fileEntriesDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clean": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
