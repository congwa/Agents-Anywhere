{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sessionNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "externalSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sourceEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "fileEntriesDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "positionRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leafId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "runtimeId",
    "sessionNamespace",
    "sessionId",
    "sourceEpoch",
    "fileEntriesDigest",
    "positionRevision",
    "leafId"
  ],
  "additionalProperties": false
}
