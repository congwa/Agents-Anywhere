{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sessionNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "externalSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "limit": {
      "default": 100,
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": [
    "runtimeId",
    "sessionNamespace",
    "sessionId",
    "limit"
  ],
  "additionalProperties": false
}
