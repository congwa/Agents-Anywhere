{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sessionNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "externalSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "clientMessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    }
  },
  "required": [
    "runtimeId",
    "sessionNamespace",
    "sessionId",
    "content",
    "clientMessageId"
  ],
  "additionalProperties": false
}
