{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "sessionNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "preparationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "createOperationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "platformSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "catalogRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
